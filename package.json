{
	"name": "vanishtodo",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "bun run build && vite preview",
		"deploy": "bun run build && wrangler deploy",
		"check": "biome check --write ./src ./worker",
		"cf-typegen": "wrangler types",
		"migrate": "wrangler d1 migrations apply vanishtodo-db",
		"initdb": "wrangler d1 execute vanishtodo-db --local --file=./migrations/0001_init-schema.sql"
	},
	"dependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@mui/icons-material": "^7.3.7",
		"@mui/material": "^7.3.7",
		"@mui/x-date-pickers": "^8.24.0",
		"dayjs": "^1.11.19",
		"drizzle-orm": "^0.45.1",
		"hono": "^4.11.4",
		"jose": "^6.1.3",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"react-router": "^7.12.0",
		"resend": "^6.7.0",
		"uuid": "^13.0.0",
		"valibot": "^1.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.11",
		"@cloudflare/vite-plugin": "^1.20.1",
		"@types/node": "^24.10.7",
		"@types/react": "^19.2.8",
		"@types/react-dom": "^19.2.3",
		"@types/uuid": "^11.0.0",
		"@vitejs/plugin-react": "^5.1.2",
		"drizzle-kit": "^0.31.8",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"wrangler": "^4.58.0"
	}
}
